---
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/data";

const home = getHome();
---

<Layout title={`${home.name} — Filmmaker & Photographer`} transparentHeader>
  <section class="hero">
    <div class="hero-media">
      <video src={home.heroVideo} autoplay muted loop playsinline></video>
    </div>
    <div class="hero-copy">
      <h1>{home.name}</h1>
      <p class="tagline">{home.tagline}</p>
      <a class="btn" href="/work">{home.ctaLabel}</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  .hero-media {
    position: relative;
    background: #000;
    overflow: hidden;
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 22px;
    padding: 48px;
  }

  .hero-copy h1 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
  }

  .tagline {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 380px;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-media {
      height: 45vh;
    }

    .hero-copy {
      padding: 56px 24px 40px;
    }
  }
</style>
