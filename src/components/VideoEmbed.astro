---
interface Props {
  embed: string;
  title: string;
}

const { embed, title } = Astro.props;
---

<div class="video-embed">
  <iframe
    src={embed}
    title={title}
    loading="lazy"
    allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
    allowfullscreen
    frameborder="0"
  ></iframe>
</div>

<style>
  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
    border-radius: 8px;
    overflow: hidden;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
