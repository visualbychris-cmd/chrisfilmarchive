---
import Layout from "../layouts/Layout.astro";
import VideoEmbed from "./VideoEmbed.astro";
import { getHome, getSections } from "../lib/data";
import type { VideoItem } from "../lib/data";

interface Props {
  slug: string;
  items: VideoItem[];
}

const { slug, items } = Astro.props;
const home = getHome();
const { items: sections } = getSections();
const current = sections.find((s) => s.slug === slug)!;
const related = sections.filter((s) => s.slug !== slug);
---

<Layout title={`${current.title} — ${home.name}`} description={current.intro}>
  <section class="head">
    <h1>{current.title}</h1>
    <p>{current.intro}</p>
  </section>

  <section class="list">
    {
      items.map((item) => (
        <article class="item">
          <VideoEmbed embed={item.embed} title={item.title} />
          <h3>{item.title}</h3>
          {item.description && <p>{item.description}</p>}
        </article>
      ))
    }
  </section>

  <section class="related">
    <h2>You may also like</h2>
    <div class="related-grid">
      {
        related.map((item) => (
          <a class="related-tile" href={`/${item.slug}`}>
            <img src={item.cover} alt={item.title} loading="lazy" />
            <div class="related-caption">
              <span class="related-title">{item.title}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .head {
    padding: 140px 32px 48px;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .head h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: 0.02em;
  }

  .head p {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 14px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 56px;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 32px 80px;
  }

  .item h3 {
    margin-top: 18px;
    font-size: 1.15rem;
  }

  .item p {
    color: var(--muted);
    margin-top: 6px;
  }

  .related {
    background: #f7f7f7;
    padding: 64px 32px;
    text-align: center;
  }

  .related h2 {
    font-size: 1.4rem;
    margin-bottom: 28px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }

  .related-tile {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    display: block;
  }

  .related-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .related-tile:hover img {
    transform: scale(1.06);
  }

  .related-caption {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(2, 42, 85, 0.15), rgba(2, 42, 85, 0.6));
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    padding: 12px;
  }

  .related-title {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 720px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
